{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/spec/judge-result.schema.json",
  "title": "JudgeResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskIntent",
    "actionKnowledge",
    "interactionAdvantage",
    "completionState",
    "groundability",
    "riskLevel",
    "recommendedCapability",
    "runScore",
    "confidence",
    "reason"
  ],
  "properties": {
    "taskIntent": {
      "type": "boolean"
    },
    "actionKnowledge": {
      "type": "boolean"
    },
    "interactionAdvantage": {
      "type": "boolean"
    },
    "completionState": {
      "type": "boolean"
    },
    "groundability": {
      "type": "boolean"
    },
    "riskLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "recommendedCapability": {
      "enum": [
        "inspect",
        "mission",
        "diagnose",
        "practice",
        "configure",
        "compare",
        "none"
      ]
    },
    "runScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    }
  }
}
