# Runtime defaults for local development. Keep real secrets out of the repo.
DATABASE_URL=
# After setting DATABASE_URL, apply db/migrations/001_init.sql then
# db/migrations/002_runtime_documents.sql. Without it, localhost deliberately
# uses volatile memory only and is not deployment-ready.
# Zhihu credentials: only server-side.
ZHIHU_ACCESS_SECRET=
ZHIHU_API_BASE_URL=https://api.zhihu.com
ZHIHU_HACKATHON_API_BASE=https://api.zhihu.com/km-indep-home/hackathon/v2
# OpenAI-compatible model endpoint used by the protected compiler and, after
# a user's explicit Result-page click, by the optional AI result interpreter.
# It never controls a Run's state, path, usage or source evidence.
# The source provider remains Zhihu; model output cannot be published until
# schema, source-anchor and human-preview checks pass.
COMPILER_MODEL=deepseek-v4-pro
COMPILER_API_BASE_URL=https://api.openai-next.com/v1
COMPILER_API_KEY=
# Optional override for Result-page AI interpretation. Empty means it reuses
# COMPILER_MODEL and the same server-only credentials.
RUNTIME_AI_MODEL=
# Optional P1 OAuth login. Keep the App Key server-side; never expose it as NEXT_PUBLIC_*.
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=
OPERATOR_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
